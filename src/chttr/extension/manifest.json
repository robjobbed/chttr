{
  "manifest_version": 3,
  "name": "chttr for Google Meet",
  "version": "1.1.0",
  "description": "Tells chttr when you join a Meet call and whom the captions say is speaking, so meeting transcripts get names. Nothing leaves your computer.",
  "key": "",
  "permissions": ["nativeMessaging"],
  "background": {"service_worker": "background.js"},
  "content_scripts": [
    {"matches": ["https://meet.google.com/*"], "js": ["content.js"], "run_at": "document_idle"}
  ],
  "action": {"default_title": "chttr"}
}
