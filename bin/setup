#!/bin/bash
# Install the chttr command from this checkout (editable, so `omarchy plugin update`
# brings new code), then download models and set up the service, keybindings and
# Meet extension. Safe to run again; pass --help to see what `chttr setup` skips.
set -euo pipefail
dir="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

uv="$(command -v uv || true)"
if [[ -z $uv ]] && command -v mise >/dev/null; then uv="$(mise which uv 2>/dev/null || true)"; fi
if [[ -z $uv ]]; then
  if command -v omarchy >/dev/null; then
    echo "chttr is installed with uv; installing it first (omarchy pkg add uv)."
    omarchy pkg add uv
  else
    echo "chttr is installed with uv; installing it first (https://astral.sh/uv)."
    curl -LsSf https://astral.sh/uv/install.sh | sh
    export PATH="$HOME/.local/bin:$PATH"
  fi
  uv="$(command -v uv)"
fi

# whisper.cpp is optional (Parakeet is the default engine); keep it if the config uses it.
extra=()
config="${XDG_CONFIG_HOME:-$HOME/.config}/chttr/config.toml"
if [[ -f $config ]] && grep -Eq '^[[:space:]]*name[[:space:]]*=[[:space:]]*"whisper"' "$config"; then
  extra=(--with pywhispercpp)
fi

# Python: the system's own when it is 3.12 or newer (nothing to download), else a uv-managed 3.13.
py="${CHTTR_PYTHON:-$(python3 -c 'import sys; print("%d.%d" % sys.version_info[:2])' 2>/dev/null)}"
[[ $py =~ ^3\.([0-9]+)(\.[0-9]+)?$ ]] && ((BASH_REMATCH[1] >= 12)) || py=3.13

echo "Installing the chttr command (Python $py and its packages)…"

# The speech model (~670 MB) downloads while uv installs the packages; `chttr setup`
# then finds it. models.py is standard library only, so any python3 >= 3.8 runs it.
data="${XDG_DATA_HOME:-$HOME/.local/share}"
parakeet="parakeet-tdt-0.6b-v3-int8"
have_parakeet() { [[ -f $1/encoder-model.int8.onnx && -f $1/decoder_joint-model.int8.onnx && -f $1/vocab.txt ]]; }
download=
if ((${#extra[@]} == 0)) && ! have_parakeet "$HOME/.local/share/voxtype/models/$parakeet" \
  && ! have_parakeet "$data/chttr/models/$parakeet" \
  && python3 -c 'import sys; sys.exit(sys.version_info < (3, 8))' 2>/dev/null; then
  python3 -I "$dir/src/chttr/models.py" "$data/chttr/models/$parakeet" "$data/chttr/models" &
  download=$!
  trap 'kill "$download" 2>/dev/null || true' EXIT     # an interrupted download resumes next time
fi
"$uv" tool install --python "$py" --editable "$dir" "${extra[@]}" --reinstall --quiet
if [[ -n $download ]]; then
  status=0
  wait "$download" || status=$?
  trap - EXIT
  if ((status != 0)); then
    echo "The speech model didn't finish downloading; run this again to continue where it stopped."
    exit "$status"
  fi
fi
exec "$HOME/.local/bin/chttr" setup "$@"
